{
  "nodes": [
    {
      "alias": "root",
      "types": ["Root"],
      "properties": {
        "name": "profile-cache",
        "purpose": "Layer 3 profile cache: one graph serves get/save/delete. The REST client posts { action, id, profile? } to the standard graph endpoint /api/graph/profile-cache and the decision node routes to the matching branch - or rejects the request with HTTP-400 when the action is not one of the three; every branch drives the same shared v1.cache.redis cache under the profile id."
      }
    },
    {
      "alias": "decide",
      "types": ["Decision"],
      "properties": {
        "skill": "graph.math",
        "statement": [
          "MAPPING: text(={input.body.action}) -> model.action_probe",
          "MAPPING: input.body.id -> model.id",
          "IF: {model.action_probe} == '=get'\nTHEN: cache-get\nELSE: next",
          "IF: {model.action_probe} == '=save'\nTHEN: encode\nELSE: next",
          "IF: {model.action_probe} == '=delete'\nTHEN: cache-delete\nELSE: reject"
        ],
        "purpose": "Stash the profile id in the model, then route to the get, save or delete branch on the posted action. Every action is matched explicitly and anything else - including an absent action - falls through to the reject node, so the graph is a closed dispatch table rather than an open one where an unrecognised action silently takes the last branch. A graph.task OUTPUT mapping LHS may only be a constant or a 'result.'/'model.'/'<node>.' element, so the id is copied into model.id here for the branches to echo back."
      }
    },
    {
      "alias": "cache-get",
      "types": ["Task"],
      "properties": {
        "skill": "graph.task",
        "task": "v1.cache.redis",
        "ttl": "10s",
        "input": [
          "text(GET) -> header.action",
          "input.body.id -> header.key"
        ],
        "output": [
          "result -> model.bytes"
        ],
        "purpose": "GET the stored bytes (or null on a miss)"
      }
    },
    {
      "alias": "decode",
      "types": ["Task"],
      "properties": {
        "skill": "graph.task",
        "task": "v1.profile.decode",
        "ttl": "10s",
        "input": [
          "model.bytes -> *"
        ],
        "output": [
          "text(application/json) -> output.header.content-type",
          "result -> output.body"
        ],
        "purpose": "Restore the profile Map from the MsgPack bytes, or raise 404 Profile not found"
      }
    },
    {
      "alias": "encode",
      "types": ["Task"],
      "properties": {
        "skill": "graph.task",
        "task": "v1.profile.encode",
        "ttl": "10s",
        "input": [
          "input.body.profile -> *"
        ],
        "output": [
          "result -> model.bytes"
        ],
        "purpose": "Pack the posted profile Map to a MsgPack byte[]"
      }
    },
    {
      "alias": "cache-put",
      "types": ["Task"],
      "properties": {
        "skill": "graph.task",
        "task": "v1.cache.redis",
        "ttl": "10s",
        "input": [
          "text(PUT) -> header.action",
          "input.body.id -> header.key",
          "model.bytes -> *"
        ],
        "output": [
          "text(application/json) -> output.header.content-type",
          "model.id -> output.body.id",
          "int(3) -> output.body.layer",
          "text(stored) -> output.body.status"
        ],
        "purpose": "PUT the bytes under the profile id (SETEX with the default TTL)"
      }
    },
    {
      "alias": "cache-delete",
      "types": ["Task"],
      "properties": {
        "skill": "graph.task",
        "task": "v1.cache.redis",
        "ttl": "10s",
        "input": [
          "text(DELETE) -> header.action",
          "input.body.id -> header.key"
        ],
        "output": [
          "text(application/json) -> output.header.content-type",
          "model.id -> output.body.id",
          "int(3) -> output.body.layer",
          "result -> output.body.deleted"
        ],
        "purpose": "DELETE the key and report the count removed"
      }
    },
    {
      "alias": "reject",
      "types": ["Mapper"],
      "properties": {
        "skill": "graph.data.mapper",
        "mapping": [
          "text(application/json) -> output.header.content-type",
          "int(400) -> output.status",
          "text(Invalid action. Use get, save or delete) -> output.body.message"
        ],
        "purpose": "Reject an unknown or missing action - an output.status of 400+ becomes the standard error response, so a typo answers 400 instead of deleting the profile"
      }
    },
    {
      "alias": "end",
      "types": ["End"],
      "properties": {
        "purpose": "Exit - an upstream branch already shaped output.body"
      }
    }
  ],
  "connections": [
    { "source": "root", "target": "decide", "relations": [ { "type": "run", "properties": {} } ] },
    { "source": "decide", "target": "cache-get", "relations": [ { "type": "get", "properties": {} } ] },
    { "source": "decide", "target": "encode", "relations": [ { "type": "save", "properties": {} } ] },
    { "source": "decide", "target": "cache-delete", "relations": [ { "type": "delete", "properties": {} } ] },
    { "source": "decide", "target": "reject", "relations": [ { "type": "invalid", "properties": {} } ] },
    { "source": "cache-get", "target": "decode", "relations": [ { "type": "then", "properties": {} } ] },
    { "source": "decode", "target": "end", "relations": [ { "type": "then", "properties": {} } ] },
    { "source": "encode", "target": "cache-put", "relations": [ { "type": "then", "properties": {} } ] },
    { "source": "cache-put", "target": "end", "relations": [ { "type": "then", "properties": {} } ] },
    { "source": "cache-delete", "target": "end", "relations": [ { "type": "then", "properties": {} } ] },
    { "source": "reject", "target": "end", "relations": [ { "type": "then", "properties": {} } ] }
  ]
}
