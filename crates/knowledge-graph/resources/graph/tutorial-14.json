{
  "nodes": [
    {
      "alias": "root",
      "types": [
        "Root"
      ],
      "properties": {
        "purpose": "Purchase workflow with three human checkpoints: a customer orders, the store manager approves or rejects with a reason (a rejection ends the workflow), the delivery department releases the shipment, and the parcel ships to the customer - four short runs sharing one correlation ID",
        "name": "tutorial-14"
      }
    },
    {
      "alias": "resume",
      "types": [
        "Resume"
      ],
      "properties": {
        "skill": "graph.resume",
        "task": "v1.redis.retrieve.model",
        "purpose": "Restore workflow state if this transaction was suspended earlier"
      }
    },
    {
      "alias": "check-fresh",
      "types": [
        "Decision"
      ],
      "properties": {
        "skill": "graph.math",
        "statement": [
          "MAPPING: text(={input.body.item}) -> model.order_probe",
          "IF: {model.order_probe} == '=null'\nTHEN: reject\nELSE: order"
        ],
        "purpose": "Input validation: a fresh transaction must be an order submission - any later-stage request without a suspended record is rejected"
      }
    },
    {
      "alias": "order",
      "types": [
        "Suspensible"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "suspend": true,
        "mapping": [
          "input.body -> model.order",
          "text(order-submitted; waiting for store manager approval) -> output.body.stage",
          "model.run -> output.body.run",
          "model.cid -> output.body.cid"
        ],
        "purpose": "Capture the order step, then suspend for the next actor"
      }
    },
    {
      "alias": "check-approval",
      "types": [
        "Decision"
      ],
      "properties": {
        "skill": "graph.math",
        "statement": [
          "MAPPING: text(={input.body.decision}) -> model.approval_probe",
          "RESET: check-approval await-decision",
          "IF: {model.approval_probe} == '=approved'\nTHEN: approval\nELSE: next",
          "IF: {model.approval_probe} == '=rejected'\nTHEN: manager-reject\nELSE: await-decision"
        ],
        "purpose": "The store manager decides: approved continues to the delivery release, rejected ends the workflow with the manager's reason, and anything else re-suspends to keep waiting - the RESET clears both loop nodes' seen marks so the wait loop can run again on every resume"
      }
    },
    {
      "alias": "await-decision",
      "types": [
        "Suspensible"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "suspend": true,
        "mapping": [
          "text(awaiting-decision; supply decision approved or rejected for the store manager) -> output.body.stage",
          "model.run -> output.body.run",
          "model.cid -> output.body.cid"
        ],
        "purpose": "No valid decision yet: re-suspend for the store manager - an invalid or missing decision must not end a long-running workflow"
      }
    },
    {
      "alias": "manager-reject",
      "types": [
        "mapper"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "mapping": [
          "text(rejected) -> output.body.stage",
          "input.body.reason -> output.body.reason",
          "model.order -> output.body.order",
          "model.run -> output.body.run",
          "model.cid -> output.body.cid"
        ],
        "purpose": "The manager rejected the purchase: report the reason with the original order and end the workflow - no further checkpoints"
      }
    },
    {
      "alias": "approval",
      "types": [
        "Suspensible"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "suspend": true,
        "mapping": [
          "input.body -> model.approval",
          "text(approved; waiting for the delivery department to release the shipment) -> output.body.stage",
          "model.run -> output.body.run",
          "model.cid -> output.body.cid"
        ],
        "purpose": "Capture the approval step, then suspend for the next actor"
      }
    },
    {
      "alias": "delivery",
      "types": [
        "Suspensible"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "suspend": true,
        "mapping": [
          "input.body -> model.delivery",
          "text(released; waiting for shipment confirmation) -> output.body.stage",
          "model.run -> output.body.run",
          "model.cid -> output.body.cid"
        ],
        "purpose": "Capture the delivery step, then suspend for the next actor"
      }
    },
    {
      "alias": "ship",
      "types": [
        "mapper"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "mapping": [
          "text(shipped) -> output.body.stage",
          "model.run -> output.body.run",
          "model.order -> output.body.order",
          "model.approval -> output.body.approval",
          "model.delivery -> output.body.delivery",
          "input.body -> output.body.shipment",
          "model.cid -> output.body.cid"
        ],
        "purpose": "Ship to the customer: complete the workflow with the full order history"
      }
    },
    {
      "alias": "reject",
      "types": [
        "mapper"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "mapping": [
          "int(404) -> output.status",
          "text(rejected) -> output.body.type",
          "text(Transaction not found. Submit the order first) -> output.body.message",
          "model.run -> output.body.run"
        ],
        "purpose": "Reject a request that has no suspended transaction and is not an order submission"
      }
    },
    {
      "alias": "suspend",
      "types": [
        "Suspend"
      ],
      "properties": {
        "skill": "graph.suspend",
        "task": "v1.redis.persist.model",
        "ttl": "1h",
        "purpose": "Persist workflow state to Redis and wait for the next actor"
      }
    },
    {
      "alias": "end",
      "types": [
        "End"
      ],
      "properties": {}
    }
  ],
