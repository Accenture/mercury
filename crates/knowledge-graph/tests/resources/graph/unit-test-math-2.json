        ]
      }
    },
    {
      "types": [
        "Module"
      ],
      "alias": "compare-bool",
      "properties": {
        "skill": "graph.math",
        "statement": [
          "COMPUTE: x -> {model.flag} < 1",
          "MAPPING: compare-bool.result.x -> output.body.x"
        ]
      }
    },
    {
      "types": [
        "Module"
      ],
      "alias": "bool-copy",
      "properties": {
        "skill": "graph.math",
        "statement": [
          "COMPUTE: x -> {model.flag}",
          "MAPPING: bool-copy.result.x -> output.body.x"
        ]
      }
    },
