{
  "nodes": [
    {
      "alias": "root",
      "types": [
        "Root"
      ],
      "properties": {
        "name": "unit-test-foreach-11",
        "purpose": "a fetcher with two dictionary items, the first fails, a handler"
      }
    },
    {
      "alias": "fan-out",
      "types": [
        "Fetcher"
      ],
      "properties": {
        "skill": "graph.api.fetcher",
        "dictionary": [
          "account-details",
          "person-name"
        ],
        "input": [
          "input.body.person_id -> person_id",
          "input.body.account_id -> account_id"
        ],
        "output": [
          "result.account_id -> output.body.account_id",
          "result.person_name -> output.body.name"
        ],
        "exception": "failed"
      }
    },
    {
      "alias": "after",
      "types": [
        "Mapper"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "mapping": [
          "text(continued) -> output.body.stage"
        ],
        "purpose": "the step after the fan-out: reached only when every element succeeded"
      }
    },
    {
      "alias": "account-details",
      "types": [
        "Dictionary"
      ],
      "properties": {
        "purpose": "Account details",
        "provider": "account-details-provider",
        "input": [
          "person_id",
          "account_id"
        ],
        "output": [
          "response.account.details.id -> result.account_id"
        ]
      }
    },
    {
      "alias": "account-details-provider",
      "types": [
        "Provider"
      ],
      "properties": {
        "purpose": "Account Management Endpoint",
        "url": "http://127.0.0.1:${rest.server.port}/api/account/details",
        "method": "POST",
        "input": [
          "text(application/json) -> header.accept",
          "text(application/json) -> header.content-type",
          "person_id -> body.person_id",
          "account_id -> body.account_id"
        ]
      }
    },
    {
      "alias": "person-name",
      "types": [
        "Dictionary"
      ],
      "properties": {
        "purpose": "name of a person",
        "provider": "mdm-profile",
        "input": [
          "person_id"
        ],
        "output": [
          "response.profile.name -> result.person_name"
        ]
      }
    },
    {
      "alias": "mdm-profile",
      "types": [
        "Provider"
      ],
      "properties": {
        "purpose": "profile management endpoint",
        "url": "http://127.0.0.1:${rest.server.port}/api/mdm/profile/{id}",
        "method": "GET",
        "input": [
          "text(application/json) -> header.accept",
          "person_id -> path_parameter.id"
        ]
      }
    },
    {
      "alias": "island",
      "types": [
        "Island"
      ],
      "properties": {
        "skill": "graph.island",
        "purpose": "anchors the handler"
      }
    },
    {
      "alias": "failed",
      "types": [
        "Handler"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "mapping": [
          "error.source -> output.body.source",
          "error.code -> output.body.code",
          "error.message -> output.body.message",
          "fan-out.result -> output.body.partial",
          "text(handled) -> output.body.stage"
        ],
        "purpose": "the exception handler of the fan-out: it reports the error context and what the node holds"
      }
    },
    {
      "alias": "end",
      "types": [
        "End"
      ],
      "properties": {}
    }
  ],
  "connections": [
    {
      "source": "root",
      "relations": [
        {
          "type": "flow",
          "properties": {}
        }
      ],
      "target": "fan-out"
    },
    {
      "source": "fan-out",
      "relations": [
        {
          "type": "flow",
          "properties": {}
        }
      ],
      "target": "after"
    },
    {
      "source": "after",
      "relations": [
        {
          "type": "flow",
          "properties": {}
        }
      ],
      "target": "end"
    },
    {
      "source": "root",
      "relations": [
        {
          "type": "flow",
          "properties": {}
        }
      ],
      "target": "island"
    },
    {
      "source": "island",
      "relations": [
        {
          "type": "flow",
          "properties": {}
        }
      ],
      "target": "failed"
    },
    {
      "source": "failed",
      "relations": [
        {
          "type": "flow",
          "properties": {}
        }
      ],
      "target": "end"
    }
  ]
}
