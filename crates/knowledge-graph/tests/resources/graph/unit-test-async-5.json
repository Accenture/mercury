{
  "nodes": [
    {
      "alias": "root",
      "types": [
        "Root"
      ],
      "properties": {
        "name": "unit-test-async-5",
        "purpose": "an asynchronous extension to a flow, with the node's own ttl"
      }
    },
    {
      "alias": "start",
      "types": [
        "Extension"
      ],
      "properties": {
        "skill": "graph.extension",
        "async": "true",
        "exception": "failed",
        "extension": "flow://async-recorder",
        "ttl": "20s",
        "input": [
          "input.body.item -> item",
          "input.body.delay -> delay"
        ]
      }
    },
    {
      "alias": "advice",
      "types": [
        "Advice"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "mapping": [
          "int(202) -> output.status",
          "text(advice) -> output.body.type",
          "text(You will receive a notification once it is complete.) -> output.body.message"
        ],
        "purpose": "the 202 advice the caller gets while the target runs"
      }
    },
    {
      "alias": "island",
      "types": [
        "Island"
      ],
      "properties": {
        "skill": "graph.island",
        "purpose": "anchors the handler"
      }
    },
    {
      "alias": "failed",
      "types": [
        "Handler"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "mapping": [
          "error.source -> output.body.source",
          "error.code -> output.body.code",
          "error.message -> output.body.message",
          "text(not started) -> output.body.stage"
        ],
        "purpose": "a failure to start routes here"
      }
    },
    {
      "alias": "end",
      "types": [
        "End"
      ],
      "properties": {}
    }
  ],
  "connections": [
    {
      "source": "root",
      "relations": [
        {
          "type": "flow",
          "properties": {}
        }
      ],
      "target": "start"
    },
    {
