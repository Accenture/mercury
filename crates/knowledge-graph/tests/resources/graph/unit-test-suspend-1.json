{
  "nodes": [
    {
      "alias": "root",
      "types": [
        "UnitTest"
      ],
      "properties": {
        "purpose": "suspend at step-1, resume continues to step-2 without re-execution",
        "name": "unit-test-suspend-1"
      }
    },
    {
      "alias": "resume",
      "types": [
        "Resume"
      ],
      "properties": {
        "skill": "graph.resume",
        "task": "v1.file.state.store",
        "purpose": "Restore workflow state if a suspension record exists"
      }
    },
    {
      "alias": "step-1",
      "types": [
        "Suspensible"
      ],
      "properties": {
        "skill": "graph.task",
        "task": "v1.counting.step",
        "input": [
          "text(one) -> step",
          "model.cid -> cid"
        ],
        "output": [
          "result.count -> model.step1_count"
        ],
        "suspend": true
      }
    },
    {
      "alias": "suspend",
      "types": [
        "Suspend"
      ],
      "properties": {
        "skill": "graph.suspend",
        "task": "v1.file.state.store",
        "ttl": "30s",
        "purpose": "Persist workflow state to the external state store"
      }
    },
    {
      "alias": "step-2",
      "types": [
        "Task"
      ],
      "properties": {
        "skill": "graph.task",
        "task": "v1.counting.step",
        "input": [
          "text(two) -> step",
          "model.cid -> cid",
          "model.step1_count -> prior"
        ],
        "output": [
          "result -> output.body",
          "model.run -> output.header.x-run"
        ]
      }
    },
    {
      "alias": "end",
      "types": [
        "End"
      ],
      "properties": {}
    }
  ],
  "connections": [
    {
      "source": "root",
      "target": "resume",
      "relations": [
        {
          "type": "test",
          "properties": {}
        }
      ]
    },
    {
