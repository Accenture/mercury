  "compile": [
    {
      "name": "full-vocabulary",
      "part": "body",
      "ok": true,
      "schema": {
        "type": "object",
        "title": "An order",
        "description": "every keyword in its place",
        "required": [
          "id",
          "amount"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "example": 7
          },
          "amount": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 1000000,
            "exclusiveMaximum": false,
            "format": "double"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[A-Za-z ]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "paid"
            ]
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "lines": {
            "type": "array",
