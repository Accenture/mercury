{
 "format": "mercury-decimal-plugin-vectors",
 "version": 1,
 "note": "Shared conformance vectors for the decimal simple plugins (RFC-0001 item 8, ADR-0025): every engine that executes flows runs these. 'plugin' is the plugin name, 'args' the call's arguments (a JSON number is a Double or Long/Integer, a string is text), 'expect' the canonical decimal string (decimalCompare: -1, 0 or 1), 'error' an engine-neutral code matched by each engine against its own message. 'expression' is the same computation as a DECIMAL statement; where present, both must give 'expect', which is what keeps the plugins and the statement from drifting.",
 "vectors": [
  {
   "id": "add-trap",
   "plugin": "decimalAdd",
   "args": [
    "0.1",
    "0.2"
   ],
   "expression": "0.1 + 0.2",
   "expect": "0.3"
  },
  {
   "id": "add-scale-larger",
   "plugin": "decimalAdd",
   "args": [
    "1.50",
