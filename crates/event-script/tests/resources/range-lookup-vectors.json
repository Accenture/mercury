     "good": "670..740",
     "fair": "580..670",
     "poor": "300..580"
    },
    799
   ],
   "expect": "very_good"
  },
  {
   "id": "score-fraction",
   "args": [
    {
     "keys": [
      "excellent",
      "very_good",
      "good",
      "fair",
      "poor"
     ],
     "excellent": "800..",
     "very_good": "740..800",
     "good": "670..740",
     "fair": "580..670",
     "poor": "300..580"
    },
    739.5
   ],
