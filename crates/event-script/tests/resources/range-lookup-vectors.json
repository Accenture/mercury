  },
  {
   "id": "error-missing-key",
   "args": [
    {
     "keys": [
      "a",
      "b"
     ],
     "a": "1..2"
    },
    1
   ],
   "error": "missing-key"
  },
  {
   "id": "error-dash-not-a-range",
   "args": [
    {
     "keys": [
      "a"
     ],
     "a": "1-2"
    },
    1
   ],
   "error": "bad-range",
   "note": "the dash form is not a range"
  },
  {
   "id": "error-both-ends-open",
   "args": [
    {
     "keys": [
      "a"
     ],
     "a": ".."
    },
    1
   ],
   "error": "bad-range"
  },
  {
   "id": "error-exclusive-marker",
   "args": [
    {
     "keys": [
      "a"
     ],
     "a": "1..<2"
    },
    1
   ],
   "error": "bad-range",
   "note": "there is one notation: the upper bound is always excluded"
  },
  {
   "id": "error-empty-range",
   "args": [
    {
     "keys": [
      "a"
     ],
     "a": "5..1"
    },
    3
   ],
   "error": "empty-range"
  },
  {
   "id": "error-equal-bounds",
   "args": [
    {
     "keys": [
      "a"
     ],
     "a": "2..2"
    },
    2
   ],
   "error": "empty-range",
   "note": "equal bounds hold nothing, since the upper bound is excluded"
  },
  {
   "id": "error-mixed-table",
   "args": [
    {
     "keys": [
      "a",
      "b"
     ],
     "a": "1..2",
     "b": "x..y"
    },
    1
   ],
   "error": "mixed-table"
  },
  {
   "id": "error-not-a-number",
   "args": [
    {
     "keys": [
      "excellent",
      "very_good",
      "good",
      "fair",
      "poor"
     ],
     "excellent": "800..",
     "very_good": "740..800",
     "good": "670..740",
     "fair": "580..670",
     "poor": "300..580"
    },
    "abc"
   ],
   "error": "not-a-number",
   "note": "numeric bands refuse a non-numeric value by name, as graph.math does"
  },
  {
   "id": "error-boolean",
   "args": [
    {
     "keys": [
      "excellent",
      "very_good",
      "good",
      "fair",
      "poor"
     ],
     "excellent": "800..",
     "very_good": "740..800",
     "good": "670..740",
     "fair": "580..670",
     "poor": "300..580"
    },
    true
   ],
   "error": "bad-value",
   "note": "the value must be a number or text on every table; a boolean sits on no scale"
  },
  {
   "id": "error-empty-band-beyond-hit",
   "args": [
    {
     "keys": [
      "a",
      "b"
     ],
     "a": "1..2",
     "b": "3 .. 3"
    },
    1
   ],
   "error": "empty-range",
   "note": "every band is checked when the table is read: a band that could never match is refused even when an earlier band answers"
  },
  {
   "id": "error-empty-band-null-value",
   "args": [
    {
     "keys": [
      "a",
      "b"
     ],
     "a": "1..2",
     "b": "3 .. 3"
    },
    null
   ],
   "error": "empty-range",
   "note": "a null value takes the default only from a table whose bands are all valid"
  },
  {
   "id": "error-mixed-band",
   "args": [
    {
     "keys": [
      "a"
     ],
     "a": "1..x"
    },
    1
   ],
   "error": "mixed-band",
   "note": "a single band never mixes a number and text"
  },
  {
   "id": "quoted-table-case-sensitive-lower",
   "args": [
    {
     "keys": [
      "a",
      "b"
     ],
     "a": "'A'..'M'",
     "b": "'M'.."
    },
    "m"
   ],
   "expect": "b",
   "note": "quoted bounds compare as written: a lowercase m sorts above the uppercase M, so it is the second band"
  },
  {
   "id": "quoted-table-case-sensitive-upper",
   "args": [
    {
     "keys": [
      "a",
      "b"
     ],
     "a": "'A'..'M'",
     "b": "'M'.."
    },
    "B"
   ],
   "expect": "a"
  },
  {
   "id": "quoted-zero-padded-code",
   "args": [
    {
     "keys": [
      "legacy",
      "current"
     ],
     "legacy": "'0000'..'1000'",
     "current": "'1000'.."
    },
    "0450"
   ],
   "expect": "legacy",
   "note": "quotes keep a zero-padded code as text - unquoted, 0000 and 1000 would read as a text and a numeric bound"
  },
  {
   "id": "quoted-zero-padded-code-at-bound",
   "args": [
    {
     "keys": [
      "legacy",
      "current"
     ],
     "legacy": "'0000'..'1000'",
     "current": "'1000'.."
    },
    "1000"
   ],
   "expect": "current"
  },
  {
   "id": "error-list-band-table",
   "args": [
    {
     "keys": [
      "a"
     ],
     "a": [
      "1..2"
     ]
    },
    1
   ],
   "error": "list-band",
   "note": "a band is one range, never a list"
  },
  {
   "id": "error-table-mixed-quoting",
   "args": [
    {
     "keys": [
      "a",
      "b"
     ],
     "a": "'x'..'y'",
     "b": "1..2"
    },
    1
   ],
   "error": "mixed-quoting",
   "note": "quote every bound of a table or none"
  },
  {
   "id": "error-band-mixed-quoting",
   "args": [
    {
     "keys": [
      "a"
     ],
     "a": "'x'..y"
    },
    1
   ],
   "error": "mixed-band-quoting"
  },
  {
   "id": "error-second-separator-band",
   "args": [
    {
     "keys": [
      "a"
     ],
     "a": "a..b..c"
    },
    1
   ],
   "error": "bad-range",
   "note": "an unquoted bound never contains the separator; a quoted one may"
  },
  {
   "id": "quoted-band-holds-the-other-quote",
   "args": [
    {
     "keys": [
      "names"
     ],
     "names": "\"O'Brien\"..\"O'Neil\""
    },
    "O'Hara"
   ],
   "expect": "names",
   "note": "the other quote character is ordinary text inside a quoted bound - the YAML convention"
  },
  {
   "id": "quoted-band-upper-bound-excluded-with-apostrophe",
   "args": [
    {
     "keys": [
      "names"
     ],
     "names": "\"O'Brien\"..\"O'Neil\""
    },
    "O'Neil",
    "none"
   ],
   "expect": "none"
  },
  {
   "id": "wide-characters-by-code-point",
   "args": [
    {
     "keys": [
      "wide"
     ],
     "wide": "'\uff10'..'\ud83d\ude00'"
    },
    "\uffe5"
   ],
   "expect": "wide",
   "note": "text orders by Unicode code point: U+FFE5 sits between U+FF10 and U+1F600, where UTF-16 units would put it above the emoji and miss"
  },
  {
   "id": "wide-characters-miss",
   "args": [
    {
     "keys": [
      "wide"
     ],
     "wide": "'\uff10'..'\ud83d\ude00'"
    },
    "\ud83d\ude01",
    "none"
   ],
   "expect": "none"
  },
  {
   "id": "error-list-value",
   "args": [
    {
     "keys": [
      "a"
     ],
     "a": "a..h"
    },
    [
     "b"
    ]
   ],
   "error": "bad-value",
   "note": "a band is a scale of numbers or text; a list compared as its text differed by engine, so every table refuses it by name"
  },
  {
   "id": "error-map-value",
   "args": [
    {
     "keys": [
      "a"
     ],
