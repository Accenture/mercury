     "excellent": "800..",
     "very_good": "740..800",
     "good": "670..740",
     "fair": "580..670",
     "poor": "300..580"
    }
   ],
   "error": "arity",
   "note": "one argument - carried as a single-element args list by each engine's harness"
  },
  {
   "id": "error-missing-keys",
   "args": [
    {
     "a": "1..2"
    },
    1
   ],
