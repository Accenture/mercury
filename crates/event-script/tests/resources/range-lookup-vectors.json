  },
  {
   "id": "null-value-with-default",
   "args": [
    {
     "keys": [
      "excellent",
      "very_good",
      "good",
      "fair",
      "poor"
     ],
     "excellent": "800..",
     "very_good": "740..800",
     "good": "670..740",
     "fair": "580..670",
     "poor": "300..580"
    },
    null,
    "unknown"
   ],
   "expect": "unknown",
   "note": "a null value takes the default, never an error"
  },
  {
   "id": "null-value-no-default",
   "args": [
    {
     "keys": [
      "excellent",
      "very_good",
      "good",
      "fair",
      "poor"
     ],
     "excellent": "800..",
     "very_good": "740..800",
     "good": "670..740",
     "fair": "580..670",
     "poor": "300..580"
    },
    null
   ],
   "expect": null
  },
  {
   "id": "hit-ignores-default",
   "args": [
    {
     "keys": [
      "excellent",
      "very_good",
      "good",
      "fair",
      "poor"
     ],
     "excellent": "800..",
     "very_good": "740..800",
     "good": "670..740",
     "fair": "580..670",
     "poor": "300..580"
    },
    700,
    "unknown"
   ],
   "expect": "good"
  },
  {
   "id": "time-same-day",
   "args": [
    {
     "keys": [
      "same_day",
      "next_day"
     ],
     "same_day": "00:00..16:00",
     "next_day": "16:00.."
    },
    "15:59:59"
   ],
   "expect": "same_day",
   "note": "ISO-8601 times compare as text"
  },
  {
   "id": "time-at-cut-off",
   "args": [
    {
     "keys": [
      "same_day",
      "next_day"
     ],
     "same_day": "00:00..16:00",
     "next_day": "16:00.."
    },
    "16:00"
   ],
   "expect": "next_day",
   "note": "the upper bound is the next band's lower bound"
  },
  {
   "id": "time-late",
   "args": [
    {
     "keys": [
      "same_day",
      "next_day"
     ],
     "same_day": "00:00..16:00",
     "next_day": "16:00.."
    },
    "23:59"
   ],
   "expect": "next_day"
  },
  {
   "id": "date-window-inside",
   "args": [
    {
     "keys": [
      "holiday_bonus"
     ],
     "holiday_bonus": "2026-11-15..2027-01-01"
    },
    "2026-12-31T23:59:59Z"
   ],
   "expect": "holiday_bonus",
   "note": "an ISO-8601 date-time inside a date window"
  },
  {
   "id": "date-window-at-end",
   "args": [
    {
     "keys": [
      "holiday_bonus"
     ],
     "holiday_bonus": "2026-11-15..2027-01-01"
    },
    "2027-01-01",
    "regular"
   ],
   "expect": "regular",
   "note": "the end date is excluded"
  },
  {
   "id": "initial-lower-case",
   "args": [
    {
     "keys": [
      "branch-a",
      "branch-b"
     ],
     "branch-a": "a..h",
     "branch-b": "h.."
    },
    "Garcia"
   ],
   "expect": "branch-a",
   "note": "text bands compare without case"
  },
  {
   "id": "initial-upper-case",
   "args": [
    {
     "keys": [
      "branch-a",
      "branch-b"
     ],
     "branch-a": "a..h",
     "branch-b": "h.."
    },
    "HARRIS"
   ],
   "expect": "branch-b"
  },
  {
   "id": "json-text-table-low",
   "args": [
    "{\"keys\": [\"low\", \"high\"], \"low\": \"..100\", \"high\": \"100..\"}",
    99.5
   ],
   "expect": "low",
   "note": "the whole table as JSON text"
  },
  {
   "id": "json-text-table-high",
   "args": [
    "{\"keys\": [\"low\", \"high\"], \"low\": \"..100\", \"high\": \"100..\"}",
    "100"
   ],
   "expect": "high"
  },
  {
   "id": "error-arity",
   "args": [
    {
     "keys": [
      "excellent",
      "very_good",
      "good",
      "fair",
      "poor"
