   "args": [
    {
     "keys": [
      "excellent",
      "very_good",
      "good",
      "fair",
      "poor"
     ],
     "excellent": "800..",
     "very_good": "740..800",
     "good": "670..740",
     "fair": "580..670",
     "poor": "300..580"
    },
    "300"
   ],
   "expect": "poor"
  },
  {
