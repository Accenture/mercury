{
 "format": "mercury-range-lookup-vectors",
 "version": 1,
 "note": "Shared conformance vectors for the rangeLookup simple plugin: every engine that executes flows runs these. 'args' are the call's arguments (a JSON object is the range table - a decision-table shape whose bands are ranges written as text; a JSON number is a Double or Long/Integer, a string is text, null is a null value), 'expect' the band name or null, the value must be a number or text (a boolean, a list or a map is refused by name on every table); text orders by Unicode code point; 'error' an engine-neutral code matched by each engine against its own message. A range min..max runs from min inclusive up to but excluding max; an omitted end is open. A bound is a canonical number, quoted text (single or double quotes) or unquoted text, and the table decides the comparison: numeric bounds compare the value as a decimal, quoted bounds as written and case-sensitively, unquoted text bounds as text without case; a table mixing kinds is refused, and so is a band given as a list. Every band is checked when the table is read, whatever the value: a malformed, mixed or empty band is refused by name.",
 "vectors": [
  {
   "id": "tier-open-upper-at-bound",
   "args": [
    {
     "keys": [
      "platinum",
      "gold",
      "silver",
      "standard"
     ],
     "platinum": "25000..",
     "gold": "10000..25000",
     "silver": "2500..10000",
     "standard": "..2500"
    },
    25000
   ],
   "expect": "platinum",
   "note": "the lower bound belongs to the band"
  },
  {
   "id": "tier-just-below-upper",
   "args": [
    {
     "keys": [
      "platinum",
      "gold",
      "silver",
      "standard"
     ],
     "platinum": "25000..",
     "gold": "10000..25000",
     "silver": "2500..10000",
     "standard": "..2500"
    },
    "24999.99"
   ],
   "expect": "gold",
   "note": "a numeric string compares exactly as a decimal"
  },
  {
   "id": "tier-lower-inclusive",
   "args": [
    {
     "keys": [
      "platinum",
      "gold",
      "silver",
      "standard"
     ],
     "platinum": "25000..",
     "gold": "10000..25000",
     "silver": "2500..10000",
     "standard": "..2500"
    },
    10000
   ],
   "expect": "gold"
  },
  {
   "id": "tier-upper-excluded",
   "args": [
    {
     "keys": [
      "platinum",
      "gold",
      "silver",
      "standard"
     ],
     "platinum": "25000..",
     "gold": "10000..25000",
     "silver": "2500..10000",
     "standard": "..2500"
    },
    9999.99
   ],
   "expect": "silver",
   "note": "a JSON number with a fraction is a Double; 10000 itself belongs to the next band"
  },
  {
   "id": "tier-open-lower",
   "args": [
    {
     "keys": [
      "platinum",
      "gold",
      "silver",
      "standard"
     ],
     "platinum": "25000..",
     "gold": "10000..25000",
     "silver": "2500..10000",
     "standard": "..2500"
    },
    0
   ],
   "expect": "standard"
  },
  {
   "id": "tier-negative",
   "args": [
    {
     "keys": [
      "platinum",
      "gold",
      "silver",
      "standard"
     ],
     "platinum": "25000..",
     "gold": "10000..25000",
     "silver": "2500..10000",
     "standard": "..2500"
    },
    "-50"
   ],
   "expect": "standard"
  },
  {
   "id": "tier-authored-keys-as-json-text",
   "args": [
    {
     "purpose": "a property the plugin ignores",
     "keys": "[ \"platinum\", \"gold\", \"silver\", \"standard\" ]",
     "platinum": "25000..",
     "gold": "10000..25000",
     "silver": "2500..10000",
     "standard": "..2500"
    },
    12000
   ],
   "expect": "gold",
   "note": "the shape of a node authored as keys=[ ... ] with an extra property"
  },
  {
   "id": "score-top-band-open",
   "args": [
