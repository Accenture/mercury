{
 "format": "mercury-date-plugin-vectors",
 "version": 1,
 "note": "Shared conformance vectors for the date simple plugins - addDays and daysBetween, addMonths and monthsBetween, addYears and yearsBetween: every engine that executes flows runs these. 'plugin' names the plugin, 'args' are the call's arguments, 'expect' the answer (a date as text written as YYYY-MM-DD, or a JSON integer of days, months or years), 'error' an engine-neutral code matched by each engine against its own message. A date is an ISO-8601 calendar date written exactly as YYYY-MM-DD, with no time and no time zone, and a real day of the proleptic Gregorian calendar; a result must fall within 0000-01-01 to 9999-12-31. The days of addDays, the months of addMonths and the years of addYears are a whole number, negative for an earlier date: a JSON integer, numeric text, or a floating-point number whose value is whole. addMonths and addYears keep the day of the month, and a day the resulting month lacks becomes that month's last day; no other date moves to the end of a month. daysBetween counts from the earlier date (excluded) to the later date (included), whatever the order of its arguments, so it is never negative. monthsBetween and yearsBetween count the whole months and the whole years completed from the earlier date to the later one, whatever the order of the arguments: a month is complete when the later date reaches the earlier date's day of the month, and a year when it reaches the earlier date's month and day, so a date that addMonths or addYears moved to the last day of a shorter month is one short of the count that was added. A null argument is refused.",
 "vectors": [
  {
   "id": "add-field-example",
   "plugin": "addDays",
   "args": [
    "2027-01-15",
    15
   ],
   "expect": "2027-01-30",
   "note": "the field's example"
  },
  {
   "id": "add-zero",
   "plugin": "addDays",
