{
 "format": "mercury-range-bounds-vectors",
 "version": 1,
 "note": "Shared conformance vectors for the minRange and maxRange simple plugins: every engine that executes flows runs these. 'plugin' names the plugin, 'args' are the call's arguments (a string is the range written as text, a number a default or a non-range, a list or an object a band that is not a range, null a null range), 'expect' the bound typed by the notation (a JSON integer is a 64-bit whole number; any other numeric bound is its exact decimal text, the DECIMAL convention; a string is text - a quoted bound without its quotes; null an open end without a default), 'error' an engine-neutral code matched by each engine against its own message. A range min..max runs from min inclusive up to but excluding max; an omitted end is open; a bound is a canonical number, quoted text (single or double quotes, compared as written) or unquoted text; a malformed, list, mixed or empty range is refused exactly as rangeLookup refuses such a band.",
 "vectors": [
  {
   "id": "min-whole-number",
   "plugin": "minRange",
   "args": [
    "10000..25000"
   ],
   "expect": 10000,
   "note": "a whole number is a 64-bit integer"
  },
  {
   "id": "max-whole-number",
   "plugin": "maxRange",
   "args": [
    "10000..25000"
   ],
   "expect": 25000,
   "note": "the upper bound is the first value the band leaves out"
  },
  {
   "id": "min-negative",
   "plugin": "minRange",
   "args": [
    "-5..5"
   ],
   "expect": -5
  },
  {
   "id": "max-zero",
   "plugin": "maxRange",
   "args": [
    "-1..0"
   ],
   "expect": 0
  },
  {
   "id": "min-fraction",
   "plugin": "minRange",
   "args": [
    "2500.50..10000"
   ],
   "expect": "2500.50",
   "note": "a decimal bound is its exact text, the DECIMAL convention - f:double converts it"
  },
  {
   "id": "max-fraction-open-lower",
   "plugin": "maxRange",
   "args": [
    "..0.1"
   ],
   "expect": "0.1"
  },
  {
   "id": "max-integral-fraction",
   "plugin": "maxRange",
   "args": [
    "1.0..2.0"
   ],
   "expect": "2.0",
   "note": "written with a fraction part, it is decimal text, never rounded to a whole number"
  },
  {
   "id": "min-beyond-64-bits",
   "plugin": "minRange",
   "args": [
    "100000000000000000000.."
   ],
   "expect": "100000000000000000000",
   "note": "a whole number beyond the 64-bit range is its exact text too"
  },
  {
   "id": "min-spaces-around-bounds",
   "plugin": "minRange",
   "args": [
    " 10 .. 20 "
   ],
   "expect": 10,
   "note": "spaces around a bound are not part of it"
  },
  {
   "id": "max-spaces-around-bounds",
   "plugin": "maxRange",
   "args": [
    " 10 .. 20 "
   ],
   "expect": 20
  },
  {
   "id": "min-time",
   "plugin": "minRange",
   "args": [
    "00:00..16:00"
   ],
   "expect": "00:00",
   "note": "a text bound is returned as written"
  },
  {
   "id": "max-time",
   "plugin": "maxRange",
   "args": [
    "00:00..16:00"
   ],
   "expect": "16:00"
  },
  {
   "id": "min-date",
   "plugin": "minRange",
   "args": [
    "2026-11-15..2027-01-01"
   ],
   "expect": "2026-11-15"
  },
  {
   "id": "max-date",
   "plugin": "maxRange",
   "args": [
    "2026-11-15..2027-01-01"
   ],
   "expect": "2027-01-01"
  },
  {
   "id": "min-letters-case-kept",
   "plugin": "minRange",
   "args": [
    "A..H"
   ],
   "expect": "A",
   "note": "only the lookup's comparison ignores case"
  },
  {
   "id": "max-letters-case-kept",
   "plugin": "maxRange",
   "args": [
    "A..H"
   ],
   "expect": "H"
  },
  {
   "id": "min-quoted-zero-padded",
   "plugin": "minRange",
   "args": [
    "'0020'..'0030'"
   ],
   "expect": "0020",
   "note": "quotes keep a zero-padded code as text"
  },
  {
   "id": "max-quoted-zero-padded",
   "plugin": "maxRange",
   "args": [
    "'0020'..'0030'"
   ],
   "expect": "0030"
  },
  {
   "id": "min-double-quoted-date",
   "plugin": "minRange",
   "args": [
    "\"2026-11-15\"..\"2027-01-01\""
   ],
   "expect": "2026-11-15",
   "note": "double quotes work the same"
  },
  {
   "id": "max-quoted-mixed-case",
   "plugin": "maxRange",
   "args": [
    "'A'..'h'"
   ],
   "expect": "h",
   "note": "quoted bounds compare as written, so 'A' is below 'h'"
  },
  {
   "id": "min-quoted-with-separator",
   "plugin": "minRange",
   "args": [
    "'a..b'..'c'"
   ],
   "expect": "a..b",
   "note": "a quoted bound may contain the separator"
  },
  {
   "id": "min-quoted-open-upper",
   "plugin": "minRange",
   "args": [
    "'1000'.."
   ],
   "expect": "1000",
   "note": "a quoted number is text"
  },
  {
   "id": "max-quoted-open-lower-default",
   "plugin": "maxRange",
   "args": [
    "..'m'",
    "none"
   ],
   "expect": "m"
  },
  {
   "id": "min-open-lower-null",
   "plugin": "minRange",
   "args": [
    "..2500"
   ],
   "expect": null,
   "note": "an open end has no bound"
  },
  {
   "id": "max-open-upper-null",
   "plugin": "maxRange",
   "args": [
    "25000.."
   ],
   "expect": null
  },
  {
   "id": "min-open-lower-default",
   "plugin": "minRange",
   "args": [
    "..2500",
    0
   ],
   "expect": 0,
   "note": "the optional second argument answers an open end"
  },
  {
   "id": "max-open-upper-default-text",
   "plugin": "maxRange",
   "args": [
    "25000..",
    "none"
   ],
   "expect": "none"
  },
  {
   "id": "max-of-open-lower",
   "plugin": "maxRange",
   "args": [
    "..2500"
   ],
   "expect": 2500,
   "note": "the other end is still a bound"
  },
  {
   "id": "min-of-open-upper-ignores-default",
   "plugin": "minRange",
   "args": [
    "25000..",
    0
   ],
   "expect": 25000,
   "note": "the default is ignored when the bound is written"
  },
  {
   "id": "max-text-ignores-default",
   "plugin": "maxRange",
   "args": [
    "a..h",
    "none"
   ],
   "expect": "h"
  },
  {
   "id": "error-no-arguments",
   "plugin": "minRange",
   "args": [],
   "error": "arity"
  },
  {
   "id": "error-three-arguments",
   "plugin": "maxRange",
   "args": [
    "10000..25000",
    0,
    0
   ],
   "error": "arity"
  },
  {
   "id": "error-null-range",
   "plugin": "minRange",
   "args": [
    null
   ],
   "error": "bad-range",
   "note": "a null range is not a range"
  },
  {
   "id": "error-dash-separator",
   "plugin": "maxRange",
   "args": [
    "1-2"
   ],
   "error": "bad-range"
  },
  {
   "id": "error-both-ends-open",
   "plugin": "minRange",
   "args": [
    ".."
   ],
   "error": "bad-range"
  },
  {
   "id": "error-exclusive-marker",
   "plugin": "minRange",
   "args": [
    "1..<2"
   ],
   "error": "bad-range",
   "note": "the marker of a first draft is refused rather than read"
  },
  {
   "id": "error-number-is-not-a-range",
   "plugin": "minRange",
   "args": [
    5
   ],
   "error": "bad-range"
  },
  {
   "id": "error-mixed-bounds",
   "plugin": "minRange",
   "args": [
    "1..x"
   ],
   "error": "mixed-range",
   "note": "a range never mixes a number and text"
  },
  {
   "id": "error-equal-bounds",
   "plugin": "maxRange",
   "args": [
    "3 .. 3"
   ],
   "error": "empty-range",
   "note": "the upper bound is excluded, so the range holds nothing"
  },
  {
   "id": "error-reversed-bounds",
   "plugin": "minRange",
   "args": [
    "5..1"
   ],
   "error": "empty-range"
  },
  {
   "id": "error-reversed-text-bounds",
   "plugin": "maxRange",
   "args": [
    "h..a"
   ],
   "error": "empty-range",
   "note": "text bounds compare without case"
  },
  {
   "id": "error-quoted-case-order",
   "plugin": "maxRange",
   "args": [
    "'a'..'B'"
   ],
   "error": "empty-range",
   "note": "quoted bounds compare as written: 'a' is above 'B'"
  },
  {
   "id": "error-list-band",
   "plugin": "minRange",
   "args": [
    [
     "10000..25000"
    ]
   ],
   "error": "list-band",
   "note": "a band is one range, never a list"
  },
  {
   "id": "error-map-band",
   "plugin": "maxRange",
   "args": [
    {
     "a": "1..2"
    }
   ],
   "error": "list-band"
  },
  {
   "id": "error-list-text",
   "plugin": "minRange",
   "args": [
    "[a..h]"
   ],
   "error": "list-band",
   "note": "the text of a list is refused the same way"
  },
  {
   "id": "error-second-separator",
   "plugin": "minRange",
   "args": [
    "a..b..c"
   ],
   "error": "bad-range",
   "note": "an unquoted bound never contains the separator"
  },
  {
   "id": "error-three-dots",
   "plugin": "maxRange",
   "args": [
    "1...2"
   ],
   "error": "bad-range"
  },
  {
   "id": "error-unmatched-quote",
   "plugin": "minRange",
   "args": [
    "'a..b"
   ],
   "error": "bad-range"
  },
  {
   "id": "error-text-after-quote",
   "plugin": "maxRange",
   "args": [
    "'a' x..'b'"
   ],
   "error": "bad-range"
  },
  {
   "id": "error-empty-quoted-bound",
   "plugin": "minRange",
   "args": [
    "''..'m'"
   ],
   "error": "empty-quoted",
   "note": "an open end is written by omission"
  },
  {
   "id": "error-mixed-quoting",
   "plugin": "minRange",
   "args": [
    "'a'..b"
   ],
   "error": "mixed-quoting",
   "note": "quote both bounds or neither"
  },
  {
   "id": "error-leading-zero-is-text",
   "plugin": "maxRange",
   "args": [
    "00501..10000"
   ],
   "error": "mixed-range",
   "note": "a bound with a leading zero is text; quote both bounds to compare them as text"
  }
 ]
}
